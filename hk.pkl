amends "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.56.1/hk@1.56.1#/Builtins.pkl"
import "package://github.com/hugoh/hk-config/releases/download/v1.4.1/hk-config@1.4.1#/base.pkl" as Base

min_hk_version = Base.min_hk_version

// Swift build/lint/format/test don't run through hk: `check:swiftlint`,
// `check:swiftformat`, `check:periphery`, and `test:swift` need a Swift
// toolchain (SourceKit) that hk's ubuntu `ci` runner doesn't have —
// ci.yml's `check-macos` job runs them instead. hk's ubuntu `ci` profile
// stays language-agnostic (rumdl/gitleaks/actionlint/typos/shellcheck/etc).
// `mise run check` is the local aggregate that does include the Swift steps.
local linters = new Mapping<String, Step> {
    ...Base.base
    ...Base.shell
    // Hashes scripts/gen_icon.swift + mise-tasks/icon/gen and compares
    // against assets/.icon-source.sha256 — pure cat/shasum, no swift/sips/
    // iconutil, so it runs fine on ubuntu and doesn't need excluding from
    // `ci`.
    ["icon"] = {
        glob = List("scripts/gen_icon.swift", "mise-tasks/icon/gen", "assets/.icon-source.sha256")
        check = "mise run check:icon"
    }
    // Plain `cog check` (whole history), not `--from-latest-tag`: this repo
    // has no release tag yet, and `--from-latest-tag` hard-errors with
    // "unable to get any tag" until one exists. Cheap to check full history
    // at this size — worth switching to `--from-latest-tag` once v0.1.0 is
    // tagged, to match the pattern other repos use.
    ["conventional_commit"] = {
        check = "cog check"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["commit-msg"] {
        steps = Base.commit_msg
    }
}
