#!/usr/bin/env bash
#MISE description="Build a working NetCheck.app (dev debug build)"
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
SWIFT_DIR="$ROOT_DIR/apps/NetCheck"
APP="$ROOT_DIR/target/dev-app/NetCheck.app"
CONTENTS_DIR="$APP/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
RESOURCES_DIR="$CONTENTS_DIR/Resources"

VERSION="${NETCHECK_VERSION:-}"
if [ "$VERSION" = "" ]; then
	SHA="$(cd "$ROOT_DIR" && git rev-parse --short=8 HEAD 2>/dev/null || true)"
	VERSION="${SHA:+dev-$SHA}"
	VERSION="${VERSION:-dev}"
fi

(cd "$SWIFT_DIR" && swift build --product NetCheckApp)

rm -rf "$APP"
mkdir -p "$MACOS_DIR" "$RESOURCES_DIR"
cp "$SWIFT_DIR/.build/debug/NetCheckApp" "$MACOS_DIR/NetCheckApp"
cp "$ROOT_DIR/assets/AppIcon.icns" "$RESOURCES_DIR/AppIcon.icns"

cat >"$CONTENTS_DIR/Info.plist" <<INFOPLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key>
    <string>NetCheckApp</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>net.larve.netcheck.dev</string>
    <key>CFBundleName</key>
    <string>netcheck (dev)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$VERSION</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
INFOPLIST

echo "Built $APP"
echo "Run with: open \"$APP\""
