#!/usr/bin/env bash
#MISE description="Render schema/*.schema.json to browsable HTML docs in site/schema/"
set -euo pipefail

# Uses json-schema-for-humans (https://github.com/coveooss/json-schema-for-humans),
# the standard tool for this — no hand-written schema viewer to keep in sync.
# `template_name=js_offline` bundles its CSS/JS/font assets locally instead
# of pulling jQuery/Bootstrap/Font Awesome from CDNs, so the output works
# offline and isn't at the mercy of those CDNs' uptime.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
OUT_DIR="$ROOT_DIR/site/schema"

rm -rf "$OUT_DIR"

# One self-contained output directory per schema (its own index.html plus a
# copy of the source .schema.json, for the relative links README already
# uses) — every schema under schema/*.schema.json is handled the same way,
# no name gets special-cased as the bare site/schema/index.html.
for schema_path in "$ROOT_DIR"/schema/*.schema.json; do
	name="$(basename "$schema_path" .schema.json)"
	out="$OUT_DIR/$name"
	mkdir -p "$out"

	uvx --from json-schema-for-humans generate-schema-doc \
		--config template_name=js_offline \
		--expand-buttons \
		"$schema_path" \
		"$out/index.html"

	cp "$schema_path" "$out/$name.schema.json"
	echo "Done: site/schema/$name/index.html"
done
