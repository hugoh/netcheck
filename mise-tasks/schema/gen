#!/usr/bin/env bash
#MISE description="Regenerate schema/status-field.schema.json from the StatusField Rust type"
set -euo pipefail

# Staleness is caught by netstatus::status::tests::committed_schema_matches_status_field
# (part of `cargo test`/`mise run test:rust`, already in CI) — this task is
# just the documented fix for when that test fails.

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

cargo run -p netcheck --bin netcheck-core -- schema >"$ROOT_DIR/schema/status-field.schema.json"

echo "Done: schema/status-field.schema.json"
