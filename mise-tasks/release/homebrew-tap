#!/usr/bin/env bash
#MISE description="Publish/update the netcheck Formula and netcheckapp Cask"
set -euo pipefail

# Publishes/updates the "netcheck" Formula and "netcheckapp" Cask in
# hugoh/homebrew-tap. Hand-rolled (not GoReleaser-generated like the Go
# fleet's casks) since GoReleaser doesn't build Rust/Swift, but follows the
# same on_macos/on_arm block structure as the existing casks there.
# netcheck is a Formula (plain CLI binaries) while netcheckapp is a Cask
# (it installs a .app bundle).
#
# Usage: mise run release:homebrew-tap -- <version-without-v> <cli-tarball> <netcheckapp-zip>
# Requires TAP_GITHUB_TOKEN in the environment.

VERSION="$1"
CLI_TARBALL="$2"
NETCHECKAPP_ZIP="$3"

: "${TAP_GITHUB_TOKEN:?TAP_GITHUB_TOKEN must be set}"

CLI_SHA="$(shasum -a 256 "$CLI_TARBALL" | cut -d' ' -f1)"
NETCHECKAPP_SHA="$(shasum -a 256 "$NETCHECKAPP_ZIP" | cut -d' ' -f1)"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

git clone "https://x-access-token:${TAP_GITHUB_TOKEN}@github.com/hugoh/homebrew-tap.git" "$WORK_DIR"

mkdir -p "$WORK_DIR/Formula"

cat >"$WORK_DIR/Formula/netcheck.rb" <<EOF
class Netcheck < Formula
  desc "Holistic view of macOS network status: interfaces, VPN, DNS, reachability"
  homepage "https://github.com/hugoh/netcheck"
  url "https://github.com/hugoh/netcheck/releases/download/v${VERSION}/netcheck-${VERSION}-aarch64-apple-darwin.tar.gz"
  sha256 "${CLI_SHA}"
  version "${VERSION}"

  livecheck do
    skip "Auto-generated on release."
  end

  def install
    bin.install "netcheck"
    bin.install "netcheck-tui"
    bin.install "netcheck-gui"
  end
end
EOF

cat >"$WORK_DIR/Casks/netcheckapp.rb" <<EOF
cask "netcheckapp" do
  version "${VERSION}"

  on_macos do
    on_arm do
      sha256 "${NETCHECKAPP_SHA}"
      url "https://github.com/hugoh/netcheck/releases/download/v#{version}/NetCheck-#{version}.zip"
    end
  end

  name "NetCheck"
  desc "Native SwiftUI macOS network status app"
  homepage "https://github.com/hugoh/netcheck"

  livecheck do
    skip "Auto-generated on release."
  end

  app "NetCheck.app"

  postflight do
    # Ad-hoc signed (no Developer ID / notarization), so strip the
    # quarantine attribute Homebrew sets on the downloaded artifact —
    # otherwise Gatekeeper refuses to launch it as "from an unidentified
    # developer" on first open.
    system_command "/usr/bin/xattr",
                    args: ["-cr", "#{appdir}/NetCheck.app"]
  end
end
EOF

cd "$WORK_DIR"
git config user.name "netcheck-release-bot"
git config user.email "hugoh@hugoh.net"
git add Formula/netcheck.rb Casks/netcheckapp.rb
if git diff --cached --quiet; then
	echo "No changes to publish"
	exit 0
fi
git commit -m "chore: update netcheck formula and cask to v${VERSION}"
git push origin HEAD:main
