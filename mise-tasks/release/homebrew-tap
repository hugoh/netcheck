#!/usr/bin/env bash
#MISE description="Publish/update the netcheck Formula and Cask"
set -euo pipefail

# Publishes/updates the "netcheck" Formula (the CLI binary) and "netcheck"
# Cask (NetCheck.app) in hugoh/homebrew-tap. Install with
# `brew install netcheck` for the CLI, `brew install --cask netcheck` for
# the app.
#
# Usage: mise run release:homebrew-tap -- <version-without-v> <cli-tarball> <app-zip>
# Requires TAP_GITHUB_TOKEN in the environment.

VERSION="$1"
CLI_TARBALL="$2"
APP_ZIP="$3"

: "${TAP_GITHUB_TOKEN:?TAP_GITHUB_TOKEN must be set}"

CLI_SHA="$(shasum -a 256 "$CLI_TARBALL" | cut -d' ' -f1)"
APP_SHA="$(shasum -a 256 "$APP_ZIP" | cut -d' ' -f1)"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

git clone "https://x-access-token:${TAP_GITHUB_TOKEN}@github.com/hugoh/homebrew-tap.git" "$WORK_DIR"

mkdir -p "$WORK_DIR/Formula"

cat >"$WORK_DIR/Formula/netcheck.rb" <<EOF
class Netcheck < Formula
  desc "Holistic view of macOS network status: interfaces, VPN, DNS, reachability"
  homepage "https://github.com/hugoh/netcheck"
  url "https://github.com/hugoh/netcheck/releases/download/v${VERSION}/netcheck-${VERSION}-aarch64-apple-darwin.tar.gz"
  sha256 "${CLI_SHA}"
  version "${VERSION}"

  livecheck do
    skip "Auto-generated on release."
  end

  def install
    bin.install "netcheck"
  end
end
EOF

cat >"$WORK_DIR/Casks/netcheck.rb" <<EOF
cask "netcheck" do
  version "${VERSION}"
  sha256 "${APP_SHA}"

  url "https://github.com/hugoh/netcheck/releases/download/v#{version}/NetCheck-#{version}.zip"
  name "NetCheck"
  desc "Native SwiftUI macOS network status app"
  homepage "https://github.com/hugoh/netcheck"

  depends_on macos: :big_sur
  depends_on arch:  :arm64

  livecheck do
    skip "Auto-generated on release."
  end

  app "NetCheck.app"

  postflight_steps do
    # Ad-hoc signed (no Developer ID / notarization), so strip the
    # quarantine attribute Homebrew sets on the downloaded artifact —
    # otherwise Gatekeeper refuses to launch it as "from an unidentified
    # developer" on first open.
    run "/usr/bin/xattr",
        args: ["-cr", "{{appdir}}/NetCheck.app"]
  end
end
EOF

cd "$WORK_DIR"
git config user.name "netcheck-release-bot"
git config user.email "hugoh@hugoh.net"
git add Formula/netcheck.rb Casks/netcheck.rb
if git diff --cached --quiet; then
	echo "No changes to publish"
	exit 0
fi

BRANCH="release/netcheck-v${VERSION}"
git checkout -b "$BRANCH"
git commit -m "chore: update netcheck formula and cask to v${VERSION}"
git push origin "$BRANCH"

# main requires a PR (branch protection) - open one and let it merge itself.
# required_approving_review_count is 0, so --auto merges as soon as any
# required status checks (none today, but `protection sync` may add hk's
# later) pass, without this script blocking on them.
export GH_TOKEN="$TAP_GITHUB_TOKEN"
PR_URL="$(gh pr create --repo hugoh/homebrew-tap --head "$BRANCH" --base main \
	--title "chore: update netcheck formula and cask to v${VERSION}" \
	--body "Auto-generated by netcheck's release workflow.")"
gh pr merge "$PR_URL" --repo hugoh/homebrew-tap --squash --delete-branch --auto
