--swiftversion 6.0
--maxwidth 120
--exclude apps/NetCheck/.build

# `wrapMultilineStatementBraces` puts `{` on its own line after a wrapped
# condition, which SwiftLint's `opening_brace` rule then flags. Let SwiftLint
# win: keep the brace on the same line as the last condition.
--disable wrapMultilineStatementBraces

# SwiftFormat owns trailing commas (its `trailingCommas` rule adds them on
# multiline literals); SwiftLint's `trailing_comma` rule is disabled to match.
