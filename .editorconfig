root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.swift]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,pkl,rb}]
indent_style = space
indent_size = 2

[{*.sh,mise-tasks/**}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
